#!/usr/bin/env bash
# Install autostart after linux_setup: sudo bash misc/linux_bash_daemon
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
for command in docker curl python3 systemctl timeout flock; do
    command -v "$command" >/dev/null || { echo "Missing $command; run linux_setup first." >&2; exit 1; }
done
[[ -f /etc/mole-cabinet/cabinet.conf ]] || { echo 'Run linux_setup first.' >&2; exit 1; }
install -d -m 0755 /usr/local/lib/mole-cabinet
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
install -m 0755 "$script_dir/collect_host_info.py" /usr/local/lib/mole-cabinet/collect-host-info
install -m 0755 "$script_dir/host_agent.py" /usr/local/lib/mole-cabinet/host-agent
install -m 0755 "$script_dir/update_installation.py" /usr/local/lib/mole-cabinet/update-installation
python3 -c 'import datetime,json,pathlib,sys; p=pathlib.Path("/etc/mole-cabinet/install-info.json"); old=json.loads(p.read_text()) if p.exists() else {}; old.update(repository=str(pathlib.Path(sys.argv[1]).resolve()), administrator=sys.argv[2] if sys.argv[2] != "root" else old.get("administrator", "root"), installed_at=datetime.datetime.now(datetime.timezone.utc).isoformat()); p.write_text(json.dumps(old)+"\n")' "$script_dir/.." "${SUDO_USER:-root}"
chmod 0600 /etc/mole-cabinet/install-info.json
cat > /etc/systemd/system/mole-host-agent.service <<'HOSTUNIT'
[Unit]
Description=Mole cabinet host API bridge
After=network.target
[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/mole-cabinet/host-agent
Restart=on-failure
RestartSec=5
RuntimeDirectory=mole-host-agent
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
HOSTUNIT
systemctl daemon-reload
systemctl enable mole-host-agent.service
systemctl restart mole-host-agent.service
cat > /usr/local/lib/mole-cabinet/launch <<'LAUNCHER'
#!/usr/bin/env bash
set -Eeuo pipefail
cabinet_config_mode=$(stat -Lc '%a' /etc/mole-cabinet/cabinet.conf)
if [[ $(stat -Lc '%u' /etc/mole-cabinet/cabinet.conf) != 0 ]] || (( (8#$cabinet_config_mode & 022) != 0 )); then
    echo 'INVALID CABINET CONFIGURATION: cabinet.conf must be root-owned and not group/world-writable.' >&2
    exit 1
fi
source /etc/mole-cabinet/cabinet.conf
: "${CONTAINER_NAME:=mole-game}" "${SERIAL_DEVICE:=}" "${STATUS_BIND:=0.0.0.0}" "${STATUS_PORT:=8080}"
[[ -n ${IMAGE:-} && $IMAGE != *REPLACE_WITH* ]] || { echo "Set IMAGE in /etc/mole-cabinet/cabinet.conf before starting." >&2; exit 1; }
exec 9>/run/mole-cabinet.lock
flock -n 9 || exit 0
[[ $CONTAINER_NAME =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || { echo "INVALID CONTAINER_NAME" >&2; exit 1; }
[[ $STATUS_PORT =~ ^[0-9]+$ ]] && ((STATUS_PORT > 0 && STATUS_PORT < 65536)) || { echo "INVALID STATUS_PORT" >&2; exit 1; }
# Wait for USB enumeration, never guess between multiple connected devices.
for ((attempt=0; attempt<30; attempt++)); do
    if [[ -n $SERIAL_DEVICE ]]; then
        [[ -c $SERIAL_DEVICE ]] && break
    else
        shopt -s nullglob
        devices=(/dev/serial/by-id/*)
        if ((${#devices[@]} == 0)); then devices=(/dev/ttyACM* /dev/ttyUSB*); fi
        if ((${#devices[@]} == 1)) && [[ -c ${devices[0]} ]]; then
            SERIAL_DEVICE=${devices[0]}
            break
        fi
    fi
    sleep 2
done
if [[ -z $SERIAL_DEVICE ]]; then
    if ((${#devices[@]} > 1)); then
        echo 'MULTIPLE SERIAL DEVICES FOUND: set SERIAL_DEVICE in /etc/mole-cabinet/cabinet.conf.' >&2
        printf '  %s\n' "${devices[@]}" >&2
    else
        echo 'NO SERIAL DEVICE FOUND' >&2
    fi
elif [[ ! -c $SERIAL_DEVICE ]]; then
    echo 'NO SERIAL DEVICE FOUND' >&2
    printf 'Configured SERIAL_DEVICE is unavailable: %s\n' "$SERIAL_DEVICE" >&2
    SERIAL_DEVICE=''
fi
serial_args=()
if [[ -n $SERIAL_DEVICE ]]; then serial_args=(--device "$SERIAL_DEVICE:/dev/cabinet-arduino"); fi
# A failed pull preserves the previously installed image/container.
pull_seconds=45
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then pull_seconds=300; fi
if ! timeout "$pull_seconds" docker pull "$IMAGE"; then
    echo 'Image pull failed; using installed image if available.' >&2
fi
if ! image_id=$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null); then
    # A previously installed container may reference an image with no tag left.
    image_id=$(docker inspect --format '{{.Image}}' "$CONTAINER_NAME" 2>/dev/null) || {
        echo 'No cached game image. Connect once or load an image with docker load.' >&2
        exit 1
    }
    docker image inspect "$image_id" >/dev/null
fi
python3 /usr/local/lib/mole-cabinet/collect-host-info /usr/local/lib/mole-cabinet/host-info.json "$image_id" "$IMAGE"
healthy() {
    [[ $(docker inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null) == true ]] || return 1
    docker exec "$CONTAINER_NAME" python -c \
        'import urllib.request; urllib.request.urlopen("http://127.0.0.1:8080/health", timeout=2).read()' >/dev/null 2>&1
}
wait_healthy() {
    for ((check=0; check<30; check++)); do
        if healthy; then return 0; fi
        sleep 2
    done
    return 1
}
launch_game() {
    local backup="${CONTAINER_NAME}-previous" had_previous=false
    # Recover an interrupted update without overwriting the known previous image.
    if docker container inspect "$backup" >/dev/null 2>&1; then
        had_previous=true
        if docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
            if healthy; then
                docker rm "$backup" >/dev/null
                had_previous=false
            else
                docker rm -f "$CONTAINER_NAME" >/dev/null
            fi
        fi
    fi
    if [[ $had_previous == false ]] && docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
        had_previous=true
        docker stop --time 15 "$CONTAINER_NAME" >/dev/null
        docker rename "$CONTAINER_NAME" "$backup"
    fi
    local status_publish="$STATUS_BIND:$STATUS_PORT:8080"
    if [[ $STATUS_BIND == *:* ]]; then status_publish="[$STATUS_BIND]:$STATUS_PORT:8080"; fi
    local audio_args=(--env AUDIO_ENABLED=0)
    if [[ -d /dev/snd ]]; then
        audio_args=(--device /dev/snd:/dev/snd --env "AUDIO_ENABLED=${AUDIO_ENABLED:-1}")
    fi
    if docker run -d --name "$CONTAINER_NAME" --restart unless-stopped \
        "${serial_args[@]}" \
        --env ARDUINO_PORT=/dev/cabinet-arduino --env STATUS_PORT=8080 \
        --env GAME_LOG_PATH=/data/game-events.jsonl \
        --env "FAILURE_SECONDS=${FAILURE_SECONDS:-15}" \
        --env "IDLE_FRAME_SECONDS=${IDLE_FRAME_SECONDS:-2}" \
        --env "LOG_RAW_ACCEL=${LOG_RAW_ACCEL:-0}" \
        --env "LOG_HEARTBEAT=${LOG_HEARTBEAT:-0}" \
        --env "LOG_RAINBOW_COMMANDS=${LOG_RAINBOW_COMMANDS:-0}" \
        --env "AUDIO_DEVICE=${AUDIO_DEVICE:-usb}" \
        --env "AUDIO_ENABLED=${AUDIO_ENABLED:-1}" \
        "${audio_args[@]}" \
        --mount type=bind,source=/run/mole-host-agent,target=/run/mole-host-agent,readonly \
        --mount type=bind,source=/usr/local/lib/mole-cabinet/host-info.json,target=/run/mole-host-info.json,readonly \
        --mount type=volume,source=mole-game-data,target=/data \
        --publish "$status_publish" \
        --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
        --label mole-cabinet.managed=true "$image_id" && wait_healthy; then
        if [[ $had_previous == true ]]; then docker rm "$backup" >/dev/null; fi
        echo 'Mole Game is running; state endpoint responds.'
        return 0
    fi
    # A reachable API in FAULT/MAINTENANCE is intentionally retained for recovery.
    if docker exec "$CONTAINER_NAME" python -c \
        'import urllib.request; urllib.request.urlopen("http://127.0.0.1:8080/diagnostics", timeout=2).read()' >/dev/null 2>&1; then
        echo 'Cabinet API is available in a degraded state; inspect /health and /diagnostics.' >&2
        return 0
    fi
    echo 'New game failed startup; restoring previous container.' >&2
    docker logs --tail 50 "$CONTAINER_NAME" >&2 || true
    docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
    if [[ $had_previous == true ]]; then
        docker rename "$backup" "$CONTAINER_NAME"
        docker start "$CONTAINER_NAME" >/dev/null
    fi
    return 1
}

launch_game
LAUNCHER
chmod 0755 /usr/local/lib/mole-cabinet/launch
cat > /etc/systemd/system/mole-cabinet.service <<'UNIT'
[Unit]
Description=Update and launch Mole Game cabinet
Wants=network-online.target
After=network-online.target docker.service mole-host-agent.service
Requires=docker.service mole-host-agent.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/lib/mole-cabinet/launch
RemainAfterExit=yes
Restart=on-failure
RestartSec=60
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
UNIT
# Disable the old boot hook so two launchers cannot compete.
if systemctl cat run-plainraw.service >/dev/null 2>&1; then
    systemctl disable --now run-plainraw.service
fi
systemctl daemon-reload
systemctl enable mole-cabinet.service
if ! systemctl restart mole-cabinet.service; then
    # Show the actual launcher failure alongside systemd's generic summary.
    journalctl -u mole-cabinet.service -n 20 --no-pager -o cat >&2 || true
    exit 1
fi
printf 'Autostart installed and game started. Status: sudo systemctl status mole-cabinet\nLogs: sudo journalctl -u mole-cabinet -f\n'
